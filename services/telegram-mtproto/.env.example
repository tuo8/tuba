# Create API credentials at https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# Generate this with: npm run login
# Treat the session string like a password.
TG_SESSION_STRING=

# Long random secret used by clients as Authorization: Bearer <token>
TUBA_API_TOKEN=

# Comma-separated exact browser origins allowed to call this service.
# Example: https://your-tuba.pages.dev,https://files.example.com
TUBA_ALLOWED_ORIGINS=

# Optional upload temporary directory. Temporary files are removed after transfer.
TUBA_TEMP_DIR=/tmp/tuba-uploads

# Optional bind address/port. Keep the service private or protect it with an access gateway.
HOST=127.0.0.1
PORT=8788
